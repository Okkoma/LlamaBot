    <file alias="emerald.json">../../bin/data/ressources/themes/emerald.json</file>
    <file alias="midnight.json">../../bin/data/ressources/themes/midnight.json</file>
    <file alias="nordic.json">../../bin/data/ressources/themes/nordic.json</file>
  </qresource>
</RCC>
